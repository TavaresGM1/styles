<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" page-range-format="expanded" default-locale="en-US">
  <info>
    <title>Ornithology Research</title>
    <id>http://www.zotero.org/styles/ornithology-research</id>
    <updated>2023-10-29T12:30:00Z</updated>
    <author>
      <name>Gemini (based on examples provided by user)</name>
    </author>
    <category citation-format="author-date"/>
  </info>

  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true" collapse="year-suffix" year-suffix-delimiter=", ">
    <sort>
      <key macro="year-date"/>
      <key macro="author-short"/>
    </sort>
    <layout delimiter="; " prefix="(" suffix=")">
      <group delimiter=" ">
        <text macro="author-short"/>
        <text macro="year-date"/>
        <text variable="year-suffix" font-style="normal"/>
      </group>
    </layout>
  </citation>

  <macro name="author">
    <names variable="author" font-variant="normal">
      <name name-as-sort-order="all" delimiter=", " delimiter-precedes-last="never" initialize-with=". " and="text"/>
      <et-al font-style="normal"/>
    </names>
  </macro>

  <macro name="author-short">
    <names variable="author" font-variant="normal">
      <name form="short" and="text" delimiter=", " delimiter-precedes-last="never" initialize-with=". "/>
      <et-al font-style="normal"/>
    </names>
  </macro>

  <macro name="year-date">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="editor">
    <names variable="editor">
      <name name-as-sort-order="all" delimiter=", " delimiter-precedes-last="never" initialize-with=". "/>
      <label form="short" text-case="capitalize-first" prefix=" (Ed.)" suffix=")"/>
    </names>
  </macro>

  <macro name="publisher">
    <group delimiter=", ">
      <text variable="publisher"/>
      <text variable="publisher-place"/>
    </group>
  </macro>

  <bibliography et-al-min="7" et-al-use-first="6" entry-spacing="0" hanging-indent="true">
    <sort>
      <key macro="author"/>
      <key macro="year-date"/>
    </sort>
    <layout suffix=".">
      <choose>
        <if type="article-journal">
          <group>
            <text macro="author"/>
            <date variable="issued"><date-part name="year"/></date>
            <text value=" "/>
            <text variable="title" suffix=". "/>
            <text variable="container-title-short" suffix=" "/>
            <group delimiter=":">
              <text variable="volume"/>
              <text variable="page"/>
            </group>
            <text prefix=". " variable="DOI"/>
          </group>
        </if>
        <else-if type="book">
          <group>
            <text macro="author"/>
            <date variable="issued"><date-part name="year"/></date>
            <text value=" "/>
            <text variable="title" suffix=". "/>
            <text macro="publisher"/>
          </group>
        </else-if>
        <else-if type="chapter">
          <group>
            <text macro="author"/>
            <date variable="issued"><date-part name="year"/></date>
            <text value=" "/>
            <text variable="title" suffix=". "/>
            <text value="Em: "/>
            <text macro="editor"/>
            <text variable="container-title" suffix=". "/>
            <text macro="publisher"/>
            <text variable="page" prefix=", pp "/>
          </group>
        </else-if>
        <else-if type="webpage">
          <group>
            <text macro="author"/>
            <date variable="issued"><date-part name="year"/></date>
            <text value=" "/>
            <text variable="title" suffix=". "/>
            <text variable="container-title" suffix=". "/>
            <text variable="URL" suffix=". "/>
            <date variable="accessed" prefix="Acessado em " form="text"/>
          </group>
        </else-if>
        <else-if type="thesis">
          <group>
            <text macro="author"/>
            <date variable="issued"><date-part name="year"/></date>
            <text value=" "/>
            <text variable="title" suffix=". "/>
            <text variable="genre" suffix=", "/>
            <text macro="publisher"/>
          </group>
        </else-if>
      </choose>
    </layout>
  </bibliography>
</style>
